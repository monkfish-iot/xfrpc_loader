START=99
USE_PROCD=1

JSON_FILE=/tmp/xfrpc_loader.json

gen_json_config() {
	local name ip port protocol local_if
	local join_timeout status_interval retry_interval max_retry_interval max_join_retries
	local time_sync_enabled time_sync_threshold
	local auth_enabled auth_listen_port auth_remote_proto auth_remote_host
	local auth_remote_port auth_remote_path auth_remote_timeout
	local auth_token_cache_ttl auth_token_retry_interval
	local auth_modify_local_password auth_default_username auth_default_password

	config_load xfrpc_loader
	config_get name             main server_name      ''
	config_get ip               main server_ip        ''
	config_get port             main server_port      6999
	config_get protocol         main protocol         https
	config_get local_if         main local_if         br-lan
	config_get join_timeout     main join_timeout     10
	config_get status_interval  main status_interval  60
	config_get retry_interval   main retry_interval   5
	config_get max_retry_interval main max_retry_interval 300
	config_get max_join_retries main max_join_retries 0
	config_get time_sync_enabled   main time_sync_enabled   1
	config_get time_sync_threshold main time_sync_threshold 5

	config_get auth_enabled             auth enabled              0
	config_get auth_listen_port         auth listen_port          8888
	config_get auth_remote_proto        auth remote_proto         https
	config_get auth_remote_host         auth remote_host          ''
	config_get auth_remote_port         auth remote_port          0
	config_get auth_remote_path         auth remote_path          '/api/v1/auth'
	config_get auth_remote_timeout      auth remote_timeout       10
	config_get auth_token_cache_ttl     auth token_cache_ttl      240
	config_get auth_token_retry_interval auth token_retry_interval 5
	config_get auth_modify_local_password auth modify_local_password 0
	config_get auth_default_username      auth default_username      root
	config_get auth_default_password      auth default_password      ''

	. /usr/share/libubox/jshn.sh
	json_init
	json_add_object "server"
		json_add_string name     "$name"
		json_add_string ip       "$ip"
		json_add_int    port     "$port"
		json_add_string protocol "$protocol"
	json_close_object
	json_add_string local_if "$local_if"
	json_add_object "runtime"
		json_add_int join_timeout     "$join_timeout"
		json_add_int status_interval  "$status_interval"
		json_add_int retry_interval   "$retry_interval"
		json_add_int max_retry_interval "$max_retry_interval"
		json_add_int max_join_retries "$max_join_retries"
		json_add_int time_sync_enabled "$time_sync_enabled"
		json_add_int time_sync_threshold "$time_sync_threshold"
	json_close_object
	json_add_object "auth"
		json_add_int    enabled              "$auth_enabled"
		json_add_int    listen_port          "$auth_listen_port"
		json_add_string remote_proto         "$auth_remote_proto"
		json_add_string remote_host          "$auth_remote_host"
		json_add_int    remote_port          "$auth_remote_port"
		json_add_string remote_path          "$auth_remote_path"
		json_add_int    remote_timeout       "$auth_remote_timeout"
		json_add_int    token_cache_ttl      "$auth_token_cache_ttl"
		json_add_int    token_retry_interval "$auth_token_retry_interval"
		json_add_int    modify_local_password "$auth_modify_local_password"
		json_add_string default_username      "$auth_default_username"
		json_add_string default_password      "$auth_default_password"
	json_close_object

	json_dump > "$JSON_FILE"
}

start_service() {
	gen_json_config
	[ -f "$JSON_FILE" ] || { echo "xfrpc_loader: config file not generated"; return 1; }

	# nginx 反代配置（/etc/nginx/conf.d/ubus.conf）已随本包安装，
	# 若 nginx 存在则重启一次使配置生效
	if [ -x /etc/init.d/nginx ]; then
		/etc/init.d/nginx restart 2>/dev/null
	fi

	procd_open_instance
	procd_set_param command /usr/bin/xfrpc_loader
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

reload_service() {
	stop
	start
}
