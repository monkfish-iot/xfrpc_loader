config main 'main'
	option server_name  ''
	option server_ip    '127.0.0.1'
	option server_port  '6999'
	option protocol     'https'
	option local_if     'br-lan'
	option join_timeout    '10'
	option status_interval '60'
	option retry_interval  '5'
	option max_retry_interval '300'
	option max_join_retries '0'
	option time_sync_enabled   '1'
	option time_sync_threshold '5'

config auth 'auth'
	option enabled              '1'
	option listen_port          '8888'
	option remote_proto         'https'
	option remote_host          ''
	option remote_port          '0'
	option remote_path          '/api/v1/auth'
	option remote_timeout       '10'
	option token_cache_ttl      '240'
	option token_retry_interval '5'
	option modify_local_password '0'
	option default_username      'root'
	option default_password      'admin'
