# sysupgrade 保留 /etc/skey（产线烧录的设备证书链 device.cert.pem 等
# per-device 材料）。根 CA ca.pem 随固件 rootfs 发布，无需保留。
# 仅在使用 libskey 双向认证（LOCAL_SKEY=0）时安装本脚本。

grep -qxF '/etc/skey/' /etc/sysupgrade.conf 2>/dev/null || \
	echo '/etc/skey/' >> /etc/sysupgrade.conf

exit 0
